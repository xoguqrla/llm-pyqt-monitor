&ACCESS RVO
&REL 442
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\ROBOTER\TEMPLATE\VORGABE
&PARAM DISKPATH = KRC:\R1\Program
DEF B241011_ZZ30( )
  DECL REAL FEEDER_SPEED, TRAVEL_SPEED
  DECL REAL OVER_LEN, HATCH, LAYER_T, RADIUS, HEIGHT
  DECL INT  LAYER_NUM
  DECL FRAME Tapp, T1

  GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM()
  INTERRUPT ON 3
  BAS(#INITMOV,0)
  FEEDER_OFF()
  LASER_OFF()
  DO_USER_TRIGGER = FALSE

  FEEDER_SPEED = 2.5
  TRAVEL_SPEED = 600
  ;LASER_POWER = 2700 ; W
  ROBOT_SPEED  = TRAVEL_SPEED / 60000.0
  GO_Feeder_Speed = FEEDER_SPEED * 6553.5

  WIRE_CONTROL = FALSE
  DEPOSITION_START = FALSE
  LAYER_COUNT = 0

  RADIUS   = 80
  OVER_LEN = 1
  HATCH    = 2.8
  LAYER_T  = 0.8
  HEIGHT   = 500
  LAYER_NUM = HEIGHT / LAYER_T

  $BWDSTART = FALSE
  BAS(#PTP_PARAMS, 30.0)
  PTP XP1

  $APO.CDIS = 2.0
  FEEDER_READY()
  LASER_READY()
  $OV_PRO = 50
  PTP XP1
  $OV_PRO = 100

  XP2 = XP1
  XP2.X = XP2.X - 80.0
  XP3 = XP2
  XP3.Y = XP3.Y + 20.0
  XP4 = XP1
  XP4.Y = XP4.Y + 20.0

  DEPOSITION_START = TRUE
  DO_USER_TRIGGER  = TRUE
  LAYER_COUNT = 1

  Tapp = XP1 : {X 0.0, Y 0.0, Z 30.0, A 0.0, B 0.0, C 0.0}
  PTP Tapp
  T1 = XP1
  SLIN T1 WITH $VEL = SVEL_CP(ROBOT_SPEED)

  START_TRIGGER()
  SLIN XP2 C_DIS
  SCIRC_REL {X -10.0, Y 10.0, Z 0.0}, {X 0.0, Y 20.0, Z 0.0} C_DIS
  SLIN XP4 C_DIS
  SCIRC_REL {X 10.0, Y -10.0, Z 0.0}, {X 0.0, Y -20.0, Z 0.0} C_DIS
  END_TRIGGER()
  WAIT SEC 3

  DEPOSITION_START = FALSE
  DO_USER_TRIGGER  = FALSE
END
