&ACCESS RVO
&REL 442
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\ROBOTER\TEMPLATE\VORGABE
&PARAM DISKPATH = KRC:\R1\Program
DEF B241011_ZZ30( )
DECL REAL FEEDER_SPEED, TRAVEL_SPEED
DECL REAL OVER_LEN, HATCH, LAYER_T, RADIUS, HEIGHT, CNT
DECL INT  LAYER_NUM
DECL FRAME T1, T2, T3, T4, T5, T6, T7, T8, T9, T10

;FOLD INI;%{PE}
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD USER INI
FEEDER_OFF()
LASER_OFF()
DO_USER_TRIGGER = FALSE
;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD =========== INITIAL PROCESS PARAMETERS ==========
FEEDER_SPEED = 2.5 ; m/min
TRAVEL_SPEED = 600 ; mm/min
ROBOT_SPEED  = TRAVEL_SPEED / 60000.0 ; m/s
GO_Feeder_Speed = FEEDER_SPEED * 6553.5
;ENDFOLD (INITIAL PROCESS PARAMETERS)

;FOLD ============== CONTROL PARAMETERS ===============
WIRE_CONTROL      = FALSE
DEPOSITION_START  = FALSE
LAYER_COUNT       = 0
;ENDFOLD (CONTROL PARAMETERS)

;FOLD ============= GEOMETRE PARAMETERS ===============
; TARGET GEOMETRE: HEXAGON
RADIUS   = 80
OVER_LEN = 1
HATCH    = 2.8
LAYER_T  = 0.8
HEIGHT   = 500
LAYER_NUM = HEIGHT / LAYER_T
;ENDFOLD (GEOMETRE PARAMETERS)

;FOLD =============== TEACHING POINT ==================
;FOLD PTP P3 Vel=30 % PDAT3 Tool[1]:Tool1 Base[16]:Base16 ColDetect[1] ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P3; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT3; Kuka.VelocityPtp=30; Kuka.CurrentCDSetIndex=1; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT  = PPDAT3
FDAT_ACT  = FP3
BAS(#PTP_PARAMS, 30.0)
SET_CD_PARAMS (1)
GOTO AA
PTP XP1
AA:
;ENDFOLD

HALT

; MOVE TO THE START POINT
$APO.CDIS = 2.0
FEEDER_READY()
LASER_READY()
PTP XP1

; ===== 좌표 생성(Geometry): XP1 기준 =====
DECL REAL L, H, R
L = 80.0        ; XP1->XP2 길이
H = 20.0        ; 상/하 높이차
R = 10.0        ; 반원 반지름

XP2 = XP1
XP2.X = XP2.X - L        ; -X

XP3 = XP2
XP3.Y = XP3.Y + H        ; +Y

XP4 = XP1
XP4.Y = XP4.Y + H

DEPOSITION_START = TRUE
DO_USER_TRIGGER  = TRUE
LAYER_COUNT      = 1
GO_Feeder_Speed  = FEEDER_SPEED * 6553.5

T1 = XP1
SLIN T1 WITH $VEL = SVEL_CP(ROBOT_SPEED)

; ============ TOOL PATH ===========
SLIN T1 C_DIS
CNT = 1
FEEDER_READY()
LASER_READY()
WAIT SEC 0

START_TRIGGER()

SLIN XP2 C_DIS
SCIRC_REL {X -R, Y +R, Z 0.0}, {X 0.0, Y +(2*R), Z 0.0} C_DIS
SLIN XP4 C_DIS
SCIRC_REL {X +R, Y -R, Z 0.0}, {X 0.0, Y -(2*R), Z 0.0} C_DIS

END_TRIGGER()
WAIT SEC 3

DEPOSITION_START = FALSE
DO_USER_TRIGGER  = FALSE
END
